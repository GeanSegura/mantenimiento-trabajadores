@using MantenimientoTrabajadores.api.Dto
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
}

@model List<TrabajadorDto>


<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <title>Gestión y Mantenimiento de Trabajadores</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: var(--bs-body-bg);
            color: var(--bs-body-color);
        }

        .theme-toggle {
            position: absolute;
            top: 1rem;
            right: 1rem;
        }

        .table-actions {
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .table-actions button {
                margin: 0 5px;
            }

        .modal-header {
            background-color: var(--bs-primary);
            color: white;
        }
    </style>
</head>
<body>

    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Mantenimiento de Trabajadores</h2>
            <button class="btn btn-outline-light active theme-toggle" id="toggleTheme">Dark/Light</button>

        </div>

        <!-- Botón Bandeja que abre modal -->
        <div class="mb-4">
            <button class="btn btn-info me-3" data-bs-toggle="modal" data-bs-target="#bandejaModal" id="btnVerBandeja">Ver Bandeja</button>
        </div>

        <div class="table-responsive shadow rounded">
            <table class="table table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Tipo Doc</th>
                        <th>Nro Documento</th>
                        <th>Nombres</th>
                        <th>Sexo</th>
                        <th>Departamento</th>
                        <th>Provincia</th>
                        <th>Distrito</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.vc_tipo_documento</td>
                            <td>@t.vc_numero_documento</td>
                            <td>@t.vc_nombres</td>
                            <td>@t.ch_sexo</td>
                            <td>@t.vc_nombre_departamento</td>
                            <td>@t.vc_nombre_provincia</td>
                            <td>@t.vc_nombre_distrito</td>
                            <td>
                                <button id="btnEditarGuardar" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#editarModal" data-id="@t.in_id">Editar</button>

                                <button id="btnEliminar"
                                        class="btn btn-danger btn-eliminar"
                                        data-bs-toggle="modal"
                                        data-bs-target="#confirmarEliminarModal"
                                        data-id="@t.in_id">
                                    Eliminar
                                </button>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Botón Crear Usuario -->
        <div class="text-start mt-4">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#crearModal">Crear</button>

            
            </div>
    </div>

    <!-- Modal Crear Usuario -->
    <div class="modal fade" id="crearModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="crearModalLabel" aria-hidden="true">

        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="crearModalLabel">Registrar Trabajador</h5>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label id="tipoDocumento" class="form-label">Tipo Documento</label>
                                <select class="form-select">
                                    <option value="0">DNI</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Nro Documento</label>
                                <input id="documentoInput" class="form-control" type="text" />
                                <div class="invalid-feedback">Este campo es obligatorio</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Nombres</label>
                                <input id="nombreInput" class="form-control" type="text" />
                                <div class="invalid-feedback">Este campo es obligatorio</div>

                            </div>
                            <div class="mb-3">
                                <label class="form-label">Sexo:</label><br />
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="sexo" id="sexoM" value="M" />
                                    <label class="form-check-label" for="sexoM">Masculino</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="sexo" id="sexoF" value="F" />
                                    <label class="form-check-label" for="sexoF">Femenino</label>
                                </div>
                                <div id="sexoError" class="invalid-feedback d-none">
                                    Selecciona un sexo.
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Departamento</label>
                                <select id="departamento" class="form-select">
                                    <option value="0">-- Selecciona --</option>
                                    @foreach (var item in ViewBag.Departamentos)
                                    {
                                        <option value="@item.Id">@item.NombreDepartamento</option>
                                    }
                                </select>
                                <div class="invalid-feedback">Debes seleccionar un departamento</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Provincia</label>
                                <select id="provincia" class="form-select">
                                    <option value="0">Seleccione provincia</option>
                                </select>
                                <div class="invalid-feedback">Debes seleccionar un provincia</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Distrito</label>
                                <select id="distrito" class="form-select">
                                    <option value="0">Seleccione distrito</option>
                                </select>
                                <div class="invalid-feedback">Debes seleccionar un distrito</div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="btnCancelar" data-bs-dismiss="modal">Cancelar</button>
                    <button id="btnGuardar" type="submit" class="btn btn-success">Guardar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Bandeja -->
    <div class="modal fade" id="bandejaModal" tabindex="-1" aria-labelledby="bandejaModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="bandejaModalLabel">Bandeja de Trabajadores</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 d-flex align-items-center">
                        <label class="me-2">Filtrar por sexo:</label>
                        <select class="form-select w-auto me-2">
                            <option value="">Todos</option>
                            <option value="M">Masculino</option>
                            <option value="F">Femenino</option>
                        </select>
                        <button class="btn btn-secondary">🔍 Buscar</button>
                    </div>
                    <div id="contenidoBandeja">
                        Cargando...
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Editar Usuario -->
    <div class="modal fade" id="editarModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="editarModalLabel" aria-hidden="true">

        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="crearModalLabel">Editar Trabajador</h5>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label id="tipoDocumento" class="form-label">Tipo Documento</label>
                                <select class="form-select">
                                    <option value="0">DNI</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Nro Documento</label>
                                <input id="documentoInput" class="form-control" type="text" />
                                <div class="invalid-feedback">Este campo es obligatorio</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Nombres</label>
                                <input id="nombreInput" class="form-control" type="text" />
                                <div class="invalid-feedback">Este campo es obligatorio</div>

                            </div>
                            <div class="mb-3">
                                <label class="form-label">Sexo:</label><br />
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="sexo" id="sexoM" value="M" />
                                    <label class="form-check-label" for="sexoM">Masculino</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="sexo" id="sexoF" value="F" />
                                    <label class="form-check-label" for="sexoF">Femenino</label>
                                </div>
                                <div id="sexoError" class="invalid-feedback d-none">
                                    Selecciona un sexo.
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Departamento</label>
                                <select id="departamento2" class="form-select">
                                    <option value="0">-- Selecciona --</option>
                                    @foreach (var item in ViewBag.Departamentos)
                                    {
                                        <option value="@item.Id">@item.NombreDepartamento</option>
                                    }
                                </select>
                                <div class="invalid-feedback">Debes seleccionar un departamento</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Provincia</label>
                                <select id="provincia2" class="form-select">
                                    <option value="0">Seleccione provincia</option>
                                </select>
                                <div class="invalid-feedback">Debes seleccionar un provincia</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Distrito</label>
                                <select id="distrito2" class="form-select">
                                    <option value="0">Seleccione distrito</option>
                                </select>
                                <div class="invalid-feedback">Debes seleccionar un distrito</div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="btnCancelarEditar" data-bs-dismiss="modal">Cancelar</button>
                    <button id="btnGuardarEditar" type="submit" class="btn btn-success">Guardar</button>
                </div>
            </div>
        </div>
    </div>


    @* modal de confirmacion *@
    <div class="modal fade" id="confirmarEliminarModal" tabindex="-1" aria-labelledby="confirmarEliminarLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmarEliminarLabel">Confirmar Eliminación</h5>
                </div>
                <div class="modal-body">
                    ¿Estás seguro de que deseas eliminar este registro?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="confirmarEliminarBtn">Sí, eliminar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS + Theme Switcher -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @section Scripts {
        <script src="~/js/Home/home.js"></script>
    }
    <script>
        document.getElementById("toggleTheme").addEventListener("click", () => {
          const html = document.documentElement;
          const actual = html.getAttribute("data-bs-theme");
          html.setAttribute("data-bs-theme", actual === "dark" ? "light" : "dark");
        });
    </script>
</body>
</html>
